<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="LR3D" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/LR3D" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-g" />
				</Compiler>
				<ExtraCommands>
					<Add after='cmd /c xcopy /Y /Q &quot;$(TARGET_OUTPUT_DIR)*.a&quot; &quot;$(PROJECT_DIR)..\LR3D\lib\&quot;' />
					<Add after='cmd /c xcopy /Y /Q &quot;$(PROJECT_DIR)*.hpp&quot; &quot;$(PROJECT_DIR)..\LR3D\include\&quot;' />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/LR3D" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Release/" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add directory="C:/Users/user/Desktop/LR3D/include" />
		</Compiler>
		<Linker>
			<Add library="../LR3D/lib/libLR3D.a" />
			<Add directory="C:/Users/user/Desktop/LR3D/lib" />
		</Linker>
		<ExtraCommands>
			<Add after='cmd /c xcopy /Y /Q &quot;$(TARGET_OUTPUT_DIR)*.a&quot; &quot;..\LR3D\lib\&quot;' />
			<Add after='cmd /c xcopy /Y /Q &quot;*.h&quot; &quot;..\LR3D\include\&quot;' />
		</ExtraCommands>
		<Unit filename="LR3D/Fonts/LR3D_Gorton.hpp" />
		<Unit filename="LR3D/LR3D_Clock.cpp" />
		<Unit filename="LR3D/LR3D_Clock.hpp" />
		<Unit filename="LR3D/LR3D_Color.hpp" />
		<Unit filename="LR3D/LR3D_Colors.hpp" />
		<Unit filename="LR3D/LR3D_Framebuffer.hpp" />
		<Unit filename="LR3D/LR3D_Input.hpp" />
		<Unit filename="LR3D/LR3D_Math.cpp" />
		<Unit filename="LR3D/LR3D_Math.hpp" />
		<Unit filename="LR3D/LR3D_Render.cpp" />
		<Unit filename="LR3D/LR3D_Render.hpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
